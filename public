<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FinManager AI - Smart Financial Assistant</title>
    <link rel="stylesheet" href="style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <header>
        <div class="logo">📊 FinManager AI</div>
        <nav>
            <span class="user-profile">Welcome, Vishal</span>
        </nav>
    </header>

    <main class="container">
        <section class="metrics-grid">
            <div class="card metric-card income">
                <h3>Total Income</h3>
                <p id="txt-income">₹0.00</p>
            </div>
            <div class="card metric-card expense">
                <h3>Total Expenses</h3>
                <p id="txt-expenses">₹0.00</p>
            </div>
            <div class="card metric-card balance">
                <h3>Remaining Balance</h3>
                <p id="txt-balance">₹0.00</p>
            </div>
        </section>

        <div id="alert-banner" class="alert-hidden"></div>

        <section class="main-layout">
            <div class="pillar">
                <div class="card">
                    <h2>Log Transaction</h2>
                    <div class="tab-buttons">
                        <button id="tab-exp" class="active" onclick="switchTab('expense')">Expense</button>
                        <button id="tab-inc" onclick="switchTab('income')">Income</button>
                    </div>

                    <form id="tx-form" onsubmit="handleTransactionSubmit(event)">
                        <div class="input-group">
                            <label id="lbl-title">Expense Description</label>
                            <input type="text" id="tx-title" placeholder="e.g., Grocery Shopping" required>
                        </div>
                        <div class="input-group">
                            <label>Amount (₹)</label>
                            <input type="number" id="tx-amount" placeholder="0.00" step="any" required>
                        </div>
                        <div class="input-group" id="category-group">
                            <label>Category</label>
                            <select id="tx-category">
                                <option value="Food">Food</option>
                                <option value="Travel">Travel</option>
                                <option value="Shopping">Shopping</option>
                                <option value="Bills">Bills</option>
                                <option value="Entertainment">Entertainment</option>
                                <option value="Education">Education</option>
                            </select>
                        </div>
                        <div class="input-group">
                            <label>Date</label>
                            <input type="date" id="tx-date" required>
                        </div>
                        <button type="submit" class="btn-primary">Save Entry</button>
                    </form>

                    <hr>
                    
                    <div class="receipt-scanner-zone">
                        <h3>⚡ AI Smart Receipt Scanner</h3>
                        <p class="subtitle">Upload a bill image to auto-extract details</p>
                        <input type="file" id="receipt-file" accept="image/*" onchange="scanReceipt()">
                        <div id="scanner-status"></div>
                    </div>
                </div>

                <div class="card ai-card">
                    <h2>🤖 FinManager AI Advisor</h2>
                    <div class="ai-chat-box" id="chat-output">
                        <p class="ai-msg">Hello! I monitor your expenses in the background. Ask me how to optimize your spending or predict your upcoming monthly trends!</p>
                    </div>
                    <div class="chat-input-row">
                        <input type="text" id="ai-input" placeholder="e.g., How can I save more money this month?">
                        <button onclick="askAIAdvisor()" class="btn-ai">Ask</button>
                    </div>
                </div>
            </div>

            <div class="pillar">
                <div class="card chart-container">
                    <h2>Spending Patterns Breakdown</h2>
                    <canvas id="expenseChart"></canvas>
                </div>

                <div class="card">
                    <h2>Recent Expense Logs</h2>
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th>Amount</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="expense-rows">
                                </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 FinManager AI Platform. Built cleanly for tracking & acceleration.</p>
    </footer>
</body>
</html>
